# ============================================================
# Educare Skill Academy CRM - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----- Database -----
# Local SQLite (default for development)
DATABASE_URL="file:./db/custom.db"

# ----- Supabase (PostgreSQL) -----
# 1. Create a project at https://supabase.com
# 2. Project Settings → Database → Connection string → "Transaction" or "Session" mode
# 3. Replace the placeholders below and comment out the SQLite URL above.
# DIRECT_URL is needed for Prisma migrations; DATABASE_URL for the app runtime.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# After switching:
#   bun run db:push           # push schema to new DB
#   bun run scripts/seed.ts   # re-seed demo data (optional)

# ----- Neon (PostgreSQL) -----
# 1. Create a project at https://neon.tech
# 2. Dashboard → Connection Details → copy "Connection string"
# 3. Replace the placeholder below and comment out the SQLite URL.
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DBNAME]?sslmode=require"
# For Neon's pooled connection (recommended for serverless):
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]-pooler/[DBNAME]?sslmode=require"

# ----- Auth -----
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-strong-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ----- Email Provider (Resend) -----
# Sign up at https://resend.com, get an API key, verify your sending domain.
# Used for invoice sending, EMI reminders, and welcome emails.
RESEND_API_KEY=""
EMAIL_FROM="Educare Skill Academy <noreply@yourdomain.com>"

# ----- SMS Provider (Twilio-compatible) -----
# Works with Twilio (https://twilio.com) and any Twilio-compatible SMS gateway.
# Used for EMI reminders, follow-up alerts, lead assignment notifications.
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM="+1234567890"

# ----- WhatsApp Business Cloud API -----
# 1. Meta for Developers → create a WhatsApp Business app
# 2. Get the access token and Phone Number ID
# Used for EMI reminders, payment receipts, placement updates.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ----- Cron Job Security -----
# Required for the EMI reminder cron endpoint at /api/v1/cron/emi-reminders
# Set this to a long random string and add the same value to Vercel Cron config.
# Example: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-string"

# ----- Optional: File Storage (S3-compatible for documents) -----
# Leave empty to use local file storage (not recommended for production).
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ----- Optional: App Configuration -----
# Comma-separated list of allowed CORS origins (empty = same-origin only)
# CORS_ALLOWED_ORIGINS=""

# Disable Telemetry (Next.js)
NEXT_TELEMETRY_DISABLED=1
