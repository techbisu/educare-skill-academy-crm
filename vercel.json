{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bash scripts/vercel-build.sh",
  "crons": [
    {
      "path": "/api/v1/cron/emi-reminders?secret=${CRON_SECRET}",
      "schedule": "0 9 * * *"
    }
  ]
}
